+/// The Skate rig bones published to the host, in slot order (the host's retarget relies on it).
+const POSE_BONES: [&str; 27] = [
+    "HIPS", "SPINE", "SPINE1", "SPINE2", "SPINE3", "NECK", "NECK1", "HEAD",
+    "RIGHTSHOULDER", "RIGHTARM", "RIGHTFOREARM", "RIGHTHAND",
+    "LEFTSHOULDER", "LEFTARM", "LEFTFOREARM", "LEFTHAND",
+    "RIGHTUPLEG", "RIGHTLEG", "RIGHTFOOT", "RIGHTTOEBASE",
+    "LEFTUPLEG", "LEFTLEG", "LEFTFOOT", "LEFTTOEBASE",
+    "SKATEBOARD_ROOT", "TRUCK_FRONT", "TRUCK_BACK",
+];
+
+/// Skate-axis world matrix of a rig bone -> body in WoW axes relative to `root`.
+fn pose_body(m: &[[f32; 4]; 4], root: [f32; 3]) -> PoseBody {
+    let to_wow = |v: [f32; 3]| [v[2], v[0], v[1]]; // WoW (X, Y, Z) = Skate (z, x, y)
+    let pos = to_wow([m[3][0] - root[0], m[3][1] - root[1], m[3][2] - root[2]]);
+    let basis = Mat3::from_cols(
+        Vec3::new(m[0][0], m[0][1], m[0][2]).normalize_or_zero(),
+        Vec3::new(m[1][0], m[1][1], m[1][2]).normalize_or_zero(),
+        Vec3::new(m[2][0], m[2][1], m[2][2]).normalize_or_zero(),
+    );
+    let q = Quat::from_mat3(&basis).normalize();
+    // the same cyclic axis permutation applies to the rotation axis
+    PoseBody { pos, rot: [q.z, q.x, q.y, q.w] }
+}
