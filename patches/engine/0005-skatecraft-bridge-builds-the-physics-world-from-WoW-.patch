+/// SkateCraft: a collision world made of arbitrary triangles (WoW's terrain and buildings, already
+/// in Skate axes). Two-sided, so walls work from either side; `None` when there is nothing.
+pub(crate) fn world_from_triangles(material: RetailContactMaterial, tris: &[[Vector3; 3]]) -> Option<BoardWorld> {
+    let triangles: Vec<WorldTriangle> = tris
+        .iter()
+        .map(|&vertices| WorldTriangle {
+            triangle: triangle_from_volume(vertices, 0.0, [1.0; 3], 0),
+            material,
+            tag: 0,
+        })
+        .collect();
+    if triangles.is_empty() {
+        return None;
+    }
+    let metadata = QueryMetadata {
+        packed_surfaces: vec![0u16; triangles.len()],
+        meshes: vec![QueryMesh {
+            triangle_range: 0..triangles.len(),
+            local_to_world: RetailAffineTransform::IDENTITY,
+            world_to_local: RetailAffineTransform::IDENTITY,
+            local_bounds: Bounds::from_points(triangles.iter().flat_map(|entry| entry.triangle.vertices))?,
+            matching_group: -1,
+            rejection_flags: 0,
+            geometry: 1,
+            pool: QueryPool::Ground,
+        }],
+        static_edges: Vec::new(),
+        island_flags: 0,
+    };
+    BoardWorld::with_query_metadata(triangles, metadata).ok()
+}
