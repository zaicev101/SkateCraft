+/// WoW triangles -> Skate axes around `origin`, normals of floor-like triangles pointing up.
+fn skate_triangles(patch: &[[f32; 9]], origin: [f64; 3]) -> Vec<[Vector3; 3]> {
+    let map = |x: f32, y: f32, z: f32| {
+        Vector3::new(
+            (y as f64 - origin[1]) as f32,
+            (z as f64 - origin[2]) as f32 + crate::physics::ground::HEIGHT,
+            (x as f64 - origin[0]) as f32,
+        )
+    };
+    patch
+        .iter()
+        .filter_map(|t| {
+            let (a, b, c) = (map(t[0], t[1], t[2]), map(t[3], t[4], t[5]), map(t[6], t[7], t[8]));
+            let (u, v) = ([b.x - a.x, b.y - a.y, b.z - a.z], [c.x - a.x, c.y - a.y, c.z - a.z]);
+            let n = [u[1] * v[2] - u[2] * v[1], u[2] * v[0] - u[0] * v[2], u[0] * v[1] - u[1] * v[0]];
+            let len = (n[0] * n[0] + n[1] * n[1] + n[2] * n[2]).sqrt();
+            if len < 1e-5 {
+                return None;
+            }
+            // floors face up (the skater lands on them); walls are two-sided anyway
+            Some(if n[1] / len < -0.7 { [a, c, b] } else { [a, b, c] })
+        })
+        .collect()
 }
 
