+/// What the score HUD of the WoW bridge needs, read straight from the scoring runtime.
+pub(crate) struct HudSnapshot {
+    pub active: bool,
+    pub clean: bool,
+    pub sketchy: bool,
+    pub bailing: bool,
+    pub landed_seq: u32,
+    pub bail_seq: u32,
+    pub sequence_score: f32,
+    pub line_score: f32,
+    pub multiplier: f32,
+    pub line_time: f32,
+    pub trick: String,
+    pub landed: String,
+}
+
+pub(crate) fn hud_snapshot(world: &World) -> HudSnapshot {
+    let s = world.resource::<crate::physics::SkaterRuntime>();
+    let physics = world.resource::<crate::physics::GamePhysics>();
+    HudSnapshot {
+        active: s.scoring.sequence_active(),
+        clean: s.scoring.clean(),
+        sketchy: s.scoring.sketchy(),
+        bailing: physics.board_wiping_out,
+        landed_seq: s.scoring.landing_seq,
+        bail_seq: s.scoring.bail_seq,
+        sequence_score: s.scoring.sequence_score(),
+        line_score: s.scoring.line_score(),
+        multiplier: s.scoring.multiplier(),
+        line_time: s.scoring.line_time(),
+        trick: crate::scoring_hud::display_trick(world, s.scoring.trick_name()),
+        landed: crate::scoring_hud::display_trick(world, &s.scoring.landed_trick),
+    }
+}
diff --git a/crates/skate-game/src/wowbridge.rs b/crates/skate-game/src/wowbridge.rs
index 7bd70f2..e75a1fc 100644
--- a/crates/skate-game/src/wowbridge.rs
